# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Packet captures: they contain subscriber identities (IMSI/SUPI) and, with N12,
# K_SEAF in clear, so they must never be pushed
*.pcap
*.pcapng
*.cap
*.tmp.pcap

# TLS key logs (--tls-keylog) and anything else holding key material
*.keylog
*keylog*.txt
sslkeys*

# macOS
.DS_Store

# Editors
.vscode/
.idea/
